XR = federated(addresses=list($R1, $R2),
               ranges=list(list(0, 0), list($r / 2, $c),
                           list($r / 2, 0), list($r, $c)))
XC = federated(addresses=list($C1, $C2),
               ranges=list(list(0, 0), list($r, $c / 2),
                           list(0, $c / 2), list($r, $c)))

RR = rbind(XR, XR)
RC = cbind(XR, XR)
CR = rbind(XC, XC)
CC = cbind(XC, XC)
SR = matrix(XR, rows=24, cols=6, byrow=TRUE)
SC = matrix(XC, rows=6, cols=24, byrow=FALSE)

write(RR, $RR)
write(RC, $RC)
write(CR, $CR)
write(CC, $CC)
write(SR, $SR)
write(SC, $SC)
