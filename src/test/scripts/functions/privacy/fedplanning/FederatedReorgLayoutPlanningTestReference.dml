X = read($X)
V = read($V)
TRow = t(X)
TCol = t(X)
TFull = t(X)
TBroadcast = t(X)
DRow = diag(X)
DCol = diag(X)
DFull = diag(X)
DBroadcast = diag(X)
DVRow = diag(V)
DVFull = diag(V)
DVBroadcast = diag(V)

write(TRow, $TRow)
write(TCol, $TCol)
write(TFull, $TFull)
write(TBroadcast, $TBroadcast)
write(DRow, $DRow)
write(DCol, $DCol)
write(DFull, $DFull)
write(DBroadcast, $DBroadcast)
write(DVRow, $DVRow)
write(DVFull, $DVFull)
write(DVBroadcast, $DVBroadcast)
