X = read($X)
V = read($V)
W = read($W)
Chain = t(X) %*% (X %*% V)
WChain = t(X) %*% (W * (X %*% V))
ColChain = t(X) %*% (X %*% V)
write(Chain, $Chain)
write(WChain, $WChain)
write(ColChain, $ColChain)
