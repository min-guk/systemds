XR = federated(addresses=list($XR1, $XR2),
               ranges=list(list(0, 0), list($r / 2, $c),
                           list($r / 2, 0), list($r, $c)))
XC = federated(addresses=list($XC1, $XC2),
               ranges=list(list(0, 0), list($r, $c / 2),
                           list(0, $c / 2), list($r, $c)))

RowRows = rowSums(XR)
RowCols = colSums(XR)
RowAll = sum(XR)
ColRows = rowSums(XC)
ColCols = colSums(XC)
ColAll = sum(XC)

write(RowRows, $RowRows)
write(RowCols, $RowCols)
write(RowAll, $RowAll)
write(ColRows, $ColRows)
write(ColCols, $ColCols)
write(ColAll, $ColAll)
