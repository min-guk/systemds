X = read($X)
UR = read($UR)
UC = read($UC)

RRow = X[, 3:10]
RCol = X[3:10, ]
RRowOne = X[2:5, ]
RColOne = X[, 2:5]

LRowMatrix = X
LRowMatrix[4:5, 3:5] = UR
LColMatrix = X
LColMatrix[3:5, 4:5] = UC

LRowScalar = X
LRowScalar[2, 2] = 91
LColScalar = X
LColScalar[11, 8] = 92

write(RRow, $RRow)
write(RRowOne, $RRowOne)
write(RCol, $RCol)
write(RColOne, $RColOne)
write(LRowMatrix, $LRowMatrix)
write(LColMatrix, $LColMatrix)
write(LRowScalar, $LRowScalar)
write(LColScalar, $LColScalar)
