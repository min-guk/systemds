X = read($X)
B = read($B)
V = read($V)
Left = read($Left)

RowMM = X %*% B
ColMV = X %*% V
LeftVM = Left %*% X
write(RowMM, $RowMM)
write(ColMV, $ColMV)
write(LeftVM, $LeftVM)
