XR = federated(addresses=list($XR1, $XR2),
               ranges=list(list(0, 0), list($r / 2, $c),
                           list($r / 2, 0), list($r, $c)))
XC = federated(addresses=list($XC1, $XC2),
               ranges=list(list(0, 0), list($r, $c / 2),
                           list(0, $c / 2), list($r, $c)))
TsmmLeft = t(XR) %*% XR
TsmmRight = XC %*% t(XC)
TsmmWrongCol = t(XC) %*% XC
TsmmWrongRow = XR %*% t(XR)
write(TsmmLeft, $TsmmLeft)
write(TsmmRight, $TsmmRight)
write(TsmmWrongCol, $TsmmWrongCol)
write(TsmmWrongRow, $TsmmWrongRow)
