XR = federated(addresses=list($XR1, $XR2),
               ranges=list(list(0, 0), list($r / 2, $k),
                           list($r / 2, 0), list($r, $k)))
XC = federated(addresses=list($XC1, $XC2),
               ranges=list(list(0, 0), list($r, $k / 2),
                           list(0, $k / 2), list($r, $k)))
B = read($B)
V = read($V)
Left = read($Left)

RowMM = XR %*% B
ColMV = XC %*% V
LeftVM = Left %*% XR

write(RowMM, $RowMM)
write(ColMV, $ColMV)
write(LeftVM, $LeftVM)
