XR = federated(addresses=list($XR1, $XR2),
               ranges=list(list(0, 0), list($r / 2, $c),
                           list($r / 2, 0), list($r, $c)))
XC = federated(addresses=list($XC1, $XC2),
               ranges=list(list(0, 0), list($r, $c / 2),
                           list(0, $c / 2), list($r, $c)))

UR = read($UR)
UC = read($UC)

# Multi-partition slices retain their input partitioning axis.
RRow = XR[, 3:10]
RCol = XC[3:10, ]

# Each of these slices is contained in exactly one worker partition.
RRowOne = XR[2:5, ]
RColOne = XC[, 2:5]

LRowMatrix = XR
LRowMatrix[4:5, 3:5] = UR
LColMatrix = XC
LColMatrix[3:5, 4:5] = UC

LRowScalar = XR
LRowScalar[2, 2] = 91
LColScalar = XC
LColScalar[11, 8] = 92

write(RRow, $RRow)
write(RRowOne, $RRowOne)
write(RCol, $RCol)
write(RColOne, $RColOne)
write(LRowMatrix, $LRowMatrix)
write(LColMatrix, $LColMatrix)
write(LRowScalar, $LRowScalar)
write(LColScalar, $LColScalar)
