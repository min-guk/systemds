X = read($X)
RowRows = rowSums(X)
RowCols = colSums(X)
RowAll = sum(X)
ColRows = rowSums(X)
ColCols = colSums(X)
ColAll = sum(X)
write(RowRows, $RowRows)
write(RowCols, $RowCols)
write(RowAll, $RowAll)
write(ColRows, $ColRows)
write(ColCols, $ColCols)
write(ColAll, $ColAll)
