XR = federated(addresses=list($XR1, $XR2),
               ranges=list(list(0, 0), list($r / 2, $c),
                           list($r / 2, 0), list($r, $c)))
YR = federated(addresses=list($YR1, $YR2),
               ranges=list(list(0, 0), list($r / 2, $c),
                           list($r / 2, 0), list($r, $c)))
XC = federated(addresses=list($XC1, $XC2),
               ranges=list(list(0, 0), list($r, $c / 2),
                           list(0, $c / 2), list($r, $c)))
YC = federated(addresses=list($YC1, $YC2),
               ranges=list(list(0, 0), list($r, $c / 2),
                           list(0, $c / 2), list($r, $c)))

L = read($L)
RV = read($RV)
CV = read($CV)

RR = XR + YR
CC = XC + YC
RL = XR + L
LR = L - XR
CL = XC + L
LC = L - XC
RRV = XR + RV
CCV = XC + CV
RC = XR + XC
CR = XC - XR

write(RR, $RR)
write(CC, $CC)
write(RL, $RL)
write(LR, $LR)
write(CL, $CL)
write(LC, $LC)
write(RRV, $RRV)
write(CCV, $CCV)
write(RC, $RC)
write(CR, $CR)
