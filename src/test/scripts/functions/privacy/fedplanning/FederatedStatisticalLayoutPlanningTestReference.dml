X = read($X)
Y = read($Y)
cm = as.matrix(moment(X, 2))
cv = as.matrix(cov(X, Y))
write(cm, $CMRow)
write(cm, $CMCol)
write(cm, $CMFull)
write(cm, $CMBroadcast)
write(cv, $CovRow)
write(cv, $CovCol)
write(cv, $CovFull)
write(cv, $CovBroadcast)

rowIndex = matrix(seq(1, nrow(X)), rows=nrow(X), cols=1)
overlapIndex = matrix((seq(1, nrow(X)) %% 3) + 1, rows=nrow(X), cols=1)
firstColumn = X[,1]
ctRowForward = table(firstColumn, rowIndex)
ctRowReverse = table(rowIndex, firstColumn)
ctOverlap = table(firstColumn, overlapIndex)
write(ctRowForward, $CTRowForward)
write(ctRowReverse, $CTRowReverse)
write(ctOverlap, $CTRowOverlap)
write(ctOverlap, $CTCol)
write(ctOverlap, $CTFull)
write(ctOverlap, $CTBroadcast)
