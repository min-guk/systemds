XR = federated(addresses=list($XR1, $XR2),
               ranges=list(list(0, 0), list($n / 2, $n),
                           list($n / 2, 0), list($n, $n)))
XC = federated(addresses=list($XC1, $XC2),
               ranges=list(list(0, 0), list($n, $n / 2),
                           list(0, $n / 2), list($n, $n)))
XF = federated(addresses=list($XF),
               ranges=list(list(0, 0), list($n, $n)))
XB = federated(addresses=list($XB1, $XB2),
               ranges=list(list(0, 0), list($n, $n),
                           list(0, 0), list($n, $n)))
VR = federated(addresses=list($VR1, $VR2),
               ranges=list(list(0, 0), list($n / 2, 1),
                           list($n / 2, 0), list($n, 1)))
VF = federated(addresses=list($VF),
               ranges=list(list(0, 0), list($n, 1)))
VB = federated(addresses=list($VB1, $VB2),
               ranges=list(list(0, 0), list($n, 1),
                           list(0, 0), list($n, 1)))

TRow = t(XR)
TCol = t(XC)
TFull = t(XF)
TBroadcast = t(XB)
DRow = diag(XR)
DCol = diag(XC)
DFull = diag(XF)
DBroadcast = diag(XB)
DVRow = diag(VR)
DVFull = diag(VF)
DVBroadcast = diag(VB)

write(TRow, $TRow)
write(TCol, $TCol)
write(TFull, $TFull)
write(TBroadcast, $TBroadcast)
write(DRow, $DRow)
write(DCol, $DCol)
write(DFull, $DFull)
write(DBroadcast, $DBroadcast)
write(DVRow, $DVRow)
write(DVFull, $DVFull)
write(DVBroadcast, $DVBroadcast)
