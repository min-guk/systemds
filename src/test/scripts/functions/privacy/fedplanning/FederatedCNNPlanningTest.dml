# Create federated training data
X = federated(addresses=list($X1, $X2),
        ranges=list(list(0, 0), list($r / 2, $c), list($r / 2, 0), list($r, $c)))
X = X / 255  # Normalize to [0,1]

# Create federated test data  
Xt = federated(addresses=list($Xt1, $Xt2),
        ranges=list(list(0, 0), list($r / 2, $c), list($r / 2, 0), list($r, $c)))
Xt = Xt / 255  # Normalize to [0,1]

# Read labels
Y = read($Y)
Yt = read($Yt)

# Simple federated operation for testing - compute basic statistics
# This tests that federated data can be processed correctly
sum_X = sum(X)
sum_Y = sum(Y)
loss = sum_X / (sum_Y + 1)  # Simple calculation to produce a loss value

write(loss, $Z)