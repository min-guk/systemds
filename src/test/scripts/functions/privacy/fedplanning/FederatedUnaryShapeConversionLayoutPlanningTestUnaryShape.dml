XR = federated(addresses=list($XR1, $XR2),
  ranges=list(list(0, 0), list($r / 2, $c), list($r / 2, 0), list($r, $c)))
XC = federated(addresses=list($XC1, $XC2),
  ranges=list(list(0, 0), list($r, $c / 2), list(0, $c / 2), list($r, $c)))

ExpRow = exp(XR)
SqrtCol = sqrt(XC)
ShapeRow = matrix(ExpRow, rows=6, cols=24, byrow=TRUE)
ShapeCol = matrix(SqrtCol, rows=6, cols=24, byrow=FALSE)

write(ExpRow, $ExpRow)
write(SqrtCol, $SqrtCol)
write(ShapeRow, $ShapeRow)
write(ShapeCol, $ShapeCol)
