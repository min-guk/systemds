XR = federated(addresses=list($XR1, $XR2),
               ranges=list(list(0, 0), list($r / 2, $c),
                           list($r / 2, 0), list($r, $c)))
XC = federated(addresses=list($XC1, $XC2),
               ranges=list(list(0, 0), list($r, $c / 2),
                           list(0, $c / 2), list($r, $c)))
U = read($U)
V = read($V)

SigmoidRow = XR * (1 / (1 + exp(-(U %*% t(V)))))
SigmoidCol = XC * (1 / (1 + exp(-(U %*% t(V)))))
LossRow = as.matrix(sum((XR - (U %*% t(V))) ^ 2))
LossCol = as.matrix(sum((XC - (U %*% t(V))) ^ 2))

write(SigmoidRow, $SigmoidRow)
write(SigmoidCol, $SigmoidCol)
write(LossRow, $LossRow)
write(LossCol, $LossCol)
