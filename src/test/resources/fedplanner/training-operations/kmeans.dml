X = federated(addresses=list("worker1:8001/data/P2P2D_features.data"), ranges=list(list(0, 0), list(50000, 2100)))

[C_n, Y_n] = kmeans(X=X, k=50, is_verbose=FALSE,
    runs = 1, eps = 1e-9, max_iter = 60,
    avg_sample_size_per_centroid = 50,
    seed=2026072701)
write(Y_n, "outputs/kmeans.res", format= "csv")
