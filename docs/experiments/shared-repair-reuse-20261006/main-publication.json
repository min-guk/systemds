  "filterRunnerSource": "import java.nio.file.*;\nimport java.util.*;\nimport org.junit.internal.TextListener;\nimport org.junit.runner.*;\nimport org.junit.runner.manipulation.Filter;\n\n/** Publication rerun: retain all tests except individually reproduced upstream failures. */\npublic final class FilteredSuiteRunner {\n public static void main(String[] args) throws Exception {\n  Set<String> excluded = new LinkedHashSet<>(Files.readAllLines(Path.of(args[0])));\n  Set<String> matched = new LinkedHashSet<>();\n  Class<?>[] classes = new Class<?>[args.length - 1];\n  for(int i=1; i<args.length; i++) classes[i-1] = Class.forName(args[i]);\n  Request request = Request.classes(classes).filterWith(new Filter() {\n   public boolean shouldRun(Description d) {\n    if(d.isTest()) {\n     String key = d.getClassName() + \"#\" + d.getMethodName();\n     if(excluded.contains(key)) { matched.add(key); return false; }\n     return true;\n    }\n    for(Description child : d.getChildren()) if(shouldRun(child)) return true;\n    return false;\n   }\n   public String describe() { return \"Individually reproduced upstream failures: \" + excluded; }\n  });\n  System.out.println(\"EXPLICIT_BASELINE_EXCLUSIONS=\" + excluded);\n  JUnitCore core = new JUnitCore();\n  core.addListener(new TextListener(System.out));\n  Result result = core.run(request);\n  System.out.println(\"MATCHED_EXCLUSIONS=\" + matched);\n  System.out.println(\"RESULT run=\" + result.getRunCount() + \" failures=\" + result.getFailureCount()\n   + \" ignored=\" + result.getIgnoreCount());\n  if(!matched.equals(excluded)) throw new AssertionError(\"Exclusion identity mismatch: \" + matched);\n  System.exit(result.wasSuccessful() ? 0 : 1);\n }\n}\n",
