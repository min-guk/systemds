# Global sizes for compile-time stamping in the experiment harness.
N = 50000
D = 128

X = federated(addresses=list("130.149.237.12:8001//workspace/experiments/data/binary/ADULT_features_7_1.data","130.149.237.13:8002//workspace/experiments/data/binary/ADULT_features_7_2.data","130.149.237.14:8003//workspace/experiments/data/binary/ADULT_features_7_3.data","130.149.237.15:8004//workspace/experiments/data/binary/ADULT_features_7_4.data","130.149.237.16:8005//workspace/experiments/data/binary/ADULT_features_7_5.data","130.149.237.18:8006//workspace/experiments/data/binary/ADULT_features_7_6.data","130.149.237.19:8007//workspace/experiments/data/binary/ADULT_features_7_7.data"), ranges=list(list(0,0),list(7143,128),list(7143,0),list(14286,128),list(14286,0),list(21429,128),list(21429,0),list(28572,128),list(28572,0),list(35715,128),list(35715,0),list(42858,128),list(42858,0),list(50000,128)))
Y = federated(addresses=list("130.149.237.12:8001//workspace/experiments/data/binary/ADULT_labels_7_1.data","130.149.237.13:8002//workspace/experiments/data/binary/ADULT_labels_7_2.data","130.149.237.14:8003//workspace/experiments/data/binary/ADULT_labels_7_3.data","130.149.237.15:8004//workspace/experiments/data/binary/ADULT_labels_7_4.data","130.149.237.16:8005//workspace/experiments/data/binary/ADULT_labels_7_5.data","130.149.237.18:8006//workspace/experiments/data/binary/ADULT_labels_7_6.data","130.149.237.19:8007//workspace/experiments/data/binary/ADULT_labels_7_7.data"), ranges=list(list(0,0),list(7143,1),list(7143,0),list(14286,1),list(14286,0),list(21429,1),list(21429,0),list(28572,1),list(28572,0),list(35715,1),list(35715,0),list(42858,1),list(42858,0),list(50000,1)))

Y = (Y < 0) + 1

m = multiLogReg(
  X=X, Y=Y,
  verbose=FALSE, maxi=30, maxii=5, tol=1e-9, icpt=0,
  numclasses=2, numrows=N, numcols=D
)

write(m, "tmp/w1357/f6a95f5f20283b8182a8/result", format= "csv")
