X = federated(addresses=list("130.149.237.12:8001//workspace/experiments/data/continuous/ADULT_features_5_1.data","130.149.237.13:8002//workspace/experiments/data/continuous/ADULT_features_5_2.data","130.149.237.14:8003//workspace/experiments/data/continuous/ADULT_features_5_3.data","130.149.237.15:8004//workspace/experiments/data/continuous/ADULT_features_5_4.data","130.149.237.16:8005//workspace/experiments/data/continuous/ADULT_features_5_5.data"), ranges=list(list(0,0),list(10000,128),list(10000,0),list(20000,128),list(20000,0),list(30000,128),list(30000,0),list(40000,128),list(40000,0),list(50000,128)))
Y = federated(addresses=list("130.149.237.12:8001//workspace/experiments/data/continuous/ADULT_labels_5_1.data","130.149.237.13:8002//workspace/experiments/data/continuous/ADULT_labels_5_2.data","130.149.237.14:8003//workspace/experiments/data/continuous/ADULT_labels_5_3.data","130.149.237.15:8004//workspace/experiments/data/continuous/ADULT_labels_5_4.data","130.149.237.16:8005//workspace/experiments/data/continuous/ADULT_labels_5_5.data"), ranges=list(list(0,0),list(10000,1),list(10000,0),list(20000,1),list(20000,0),list(30000,1),list(30000,0),list(40000,1),list(40000,0),list(50000,1)))

# The frozen synthetic response is continuous.  A mean threshold yields a
# deterministic, approximately balanced binary target via a privacy-permitted
# aggregate instead of treating only the single maximum row as positive.
threshold = mean(Y)
Y = (Y > threshold) * 1

beta = glm(
  X=X, Y=Y,
  dfam=2, vpow=0.0, link=2, lpow=1.0, yneg=0.0,
  icpt=0, disp=0.0, reg=0.0, tol=1e-6, moi=20, mii=5,
  verbose=FALSE
)

write(beta, "tmp/w1357/9155336895de001872b0/result", format="csv")
