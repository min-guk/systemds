X = federated(addresses=list("130.149.237.12:8001//workspace/experiments/data/continuous/ADULT_features_1_1.data"), ranges=list(list(0,0),list(50000,128)))

[C_n, Y_n] = kmeans(X=X, k=50, is_verbose=FALSE,
    runs = 1, eps = 1e-9, max_iter = 60,
    avg_sample_size_per_centroid = 50,
    seed=133815928)
write(Y_n, "tmp/w1357/d090adba0327aa09d878/result", format= "csv")
