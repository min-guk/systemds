# Global sizes for compile-time stamping in the experiment harness.
N = 32561
D = 13

X = federated(addresses=list("130.149.237.12:8001//workspace/experiments/data/ADULT_features_1_1.data"), ranges=list(list(0,0),list(32561,13)))
e = federated(addresses=list("130.149.237.12:8001//workspace/experiments/data/ADULT_labels_1_1.data"), ranges=list(list(0,0),list(32561,1)))

source("code/workloads/sliceline/slicefinder_core.dml") as SL

sigma = max(ceil(0.01 * N), 8)

[TK, TKC, dbg] = SL::slicefinderX(
  X=X,
  e=e,
  k=10,
  alpha=0.95,
  maxL=3,
  minSup=sigma,
  tpEval=TRUE,
  tpBlksz=16,
  selFeat=TRUE,
  verbose=FALSE,
  ltype="for"
)

write(TKC, "tmp/w1357/2f0b417da72018b508bf/result", format="csv")
