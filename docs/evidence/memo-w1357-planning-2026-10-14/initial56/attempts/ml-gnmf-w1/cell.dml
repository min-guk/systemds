X = federated(addresses=list("130.149.237.12:8001//workspace/experiments/data/continuous/ADULT_features_1_1.data"), ranges=list(list(0,0),list(50000,128)))

# GNMF requires non-negative input.  P2P2D contains normally distributed
# continuous columns, so shift all entries by the privacy-permitted global min.
xmin = min(X)
if (xmin < 0) {
  X = X - xmin
}

[W, H] = gnmf(X=X, rnk=10, eps=1e-8, maxi=10, seed=1011081480)

write(H, "tmp/w1357/21d49016fc16e65436f1/result", format="csv")
