X = federated(addresses=list("130.149.237.12:8001//workspace/experiments/data/continuous/ADULT_features_3_1.data","130.149.237.13:8002//workspace/experiments/data/continuous/ADULT_features_3_2.data","130.149.237.14:8003//workspace/experiments/data/continuous/ADULT_features_3_3.data"), ranges=list(list(0,0),list(16667,128),list(16667,0),list(33334,128),list(33334,0),list(50000,128)))

# VVI keeps one diagonal covariance per component.  Four components expose
# genuine responsibility/model placement choices without the D x D covariance
# materialization of VVV.  Random initialization isolates the EM workload from
# a nested KMeans initialization phase.
[labels, probability, df, bic, mu, precision, weight] = gmm(
  X=X,
  n_components=4,
  model="VVI",
  init_params="random",
  iter=10,
  reg_covar=1e-6,
  tol=1e-12,
  seed=20260904,
  verbose=FALSE
)

# PrivateAggregation forbids exporting row-level labels/probabilities.  The
# learned aggregate model is sufficient for cross-planner semantic parity.
model = cbind(mu, precision, t(weight))
write(model, "tmp/w1357/8bab50ec0ec4b6a58217/result", format="csv")
