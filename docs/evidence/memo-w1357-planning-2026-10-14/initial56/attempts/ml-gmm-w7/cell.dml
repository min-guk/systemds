X = federated(addresses=list("130.149.237.12:8001//workspace/experiments/data/continuous/ADULT_features_7_1.data","130.149.237.13:8002//workspace/experiments/data/continuous/ADULT_features_7_2.data","130.149.237.14:8003//workspace/experiments/data/continuous/ADULT_features_7_3.data","130.149.237.15:8004//workspace/experiments/data/continuous/ADULT_features_7_4.data","130.149.237.16:8005//workspace/experiments/data/continuous/ADULT_features_7_5.data","130.149.237.18:8006//workspace/experiments/data/continuous/ADULT_features_7_6.data","130.149.237.19:8007//workspace/experiments/data/continuous/ADULT_features_7_7.data"), ranges=list(list(0,0),list(7143,128),list(7143,0),list(14286,128),list(14286,0),list(21429,128),list(21429,0),list(28572,128),list(28572,0),list(35715,128),list(35715,0),list(42858,128),list(42858,0),list(50000,128)))

# VVI keeps one diagonal covariance per component.  Four components expose
# genuine responsibility/model placement choices without the D x D covariance
# materialization of VVV.  Random initialization isolates the EM workload from
# a nested KMeans initialization phase.
[labels, probability, df, bic, mu, precision, weight] = gmm(
  X=X,
  n_components=4,
  model="VVI",
  init_params="random",
  iter=10,
  reg_covar=1e-6,
  tol=1e-12,
  seed=20260904,
  verbose=FALSE
)

# PrivateAggregation forbids exporting row-level labels/probabilities.  The
# learned aggregate model is sufficient for cross-planner semantic parity.
model = cbind(mu, precision, t(weight))
write(model, "tmp/w1357/1fef24329aa830f13a9b/result", format="csv")
